extends ArrowProjectile
class_name FireballProjectile

# The Staff's projectile. Flies and reflects like an arrow, but:
#   - a charged shot grows (the whole node scales, so the sprite and the collision
#     shape get bigger and wider together);
#   - a held (heavy) shot explodes on contact, with a fighter or a wall: everyone
#     enemy inside the blast takes damage (less toward the edge) and is thrown away
#     from the centre. A quick shot is a plain single-target hit with a small burst.
# Sprites are generated by tools/make_fireball_sprites.py.

## Extra scale per point of charge multiplier above 1.0 (a x2.5 charge gives 1.9x).
const SIZE_PER_CHARGE := 0.6
## Smallest scale, for a barely charged shot (charge below 1.0).
const MIN_SIZE := 0.8
## Flight animation speed (frames per second).
const FLIGHT_FPS := 14.0

## Blast radius in pixels at fireball size 1.0. It grows with the fireball:
## about 19 px for a barely charged shot, 46 px (roughly three fighters wide) for a full one.
const EXPLOSION_BASE_RADIUS := 24.0
## Damage on the very edge of the blast, as a share of the damage at the centre.
const EXPLOSION_EDGE_DAMAGE := 0.5
## Same for knockback force.
const EXPLOSION_EDGE_KNOCKBACK := 0.6
## Radius of the explosion sprite at its last frame, in sprite pixels (see EXPLOSION in the sprite script).
const EXPLOSION_SPRITE_RADIUS := 28.0
const EXPLOSION_SHAKE := 3.0
const EXPLOSION_SOUND_PITCH := 0.7

const IMPACT_TEXTURE: Texture2D = preload("res://assets/art/1 Characters/Other/Fireball_Impact.png")
const EXPLOSION_TEXTURE: Texture2D = preload("res://assets/art/1 Characters/Other/Fireball_Explosion.png")
const BURST_FRAMES := 6
const BURST_TIME := 0.3

## Held shots explode on contact; set from the hit in setup().
var explodes: bool = false
## Skill fireball: fixed blast radius in pixels (0 = sized by the fireball's scale, as for the heavy shot).
var radius_override: float = 0.0
## Skill fireball: leaves burning ground of this skill after exploding (null = none).
var burn_skill: SkillData = null
## Power the burn damage is based on (the caster's attack damage at cast time).
var burn_damage_per_tick: float = 0.0

@onready var _sprite: Sprite2D = $Sprite2D

var _anim_time: float = 0.0


func setup(p_hit: HitData, p_shooter: Node2D, p_charge_mult: float = 1.0) -> void:
	super.setup(p_hit, p_shooter, p_charge_mult)
	scale = Vector2.ONE * size_for_charge(p_charge_mult)
	explodes = p_hit != null and p_hit.is_heavy


func _process(delta: float) -> void:
	_anim_time += delta
	_sprite.frame = int(_anim_time * FLIGHT_FPS) % _sprite.hframes


## Scale of the fireball for a given charge multiplier.
static func size_for_charge(charge_mult: float) -> float:
	return maxf(1.0 + (charge_mult - 1.0) * SIZE_PER_CHARGE, MIN_SIZE)


## Blast radius (px) of a held fireball with the given scale.
static func blast_radius(fireball_scale: float) -> float:
	return EXPLOSION_BASE_RADIUS * fireball_scale


## Damage (or knockback) share at `distance` from the centre of a blast: 1.0 in the middle, `edge_share` at the rim.
static func falloff(distance: float, radius: float, edge_share: float) -> float:
	if radius <= 0.0:
		return 1.0
	return lerpf(1.0, edge_share, clampf(distance / radius, 0.0, 1.0))


func _on_area_entered(area: Area2D) -> void:
	if not explodes:
		super(area)
		return
	if _done or hit == null:
		return
	# Explodes on any living enemy it touches; allies, the shooter, the dead and dashing fighters (i-frames) let it through.
	var hurtbox := area as HitboxComponent
	if hurtbox == null or hurtbox.get_entity() == shooter or hurtbox.is_same_team(hit.team) or not hurtbox.can_be_hit:
		return
	if hurtbox.health != null and hurtbox.health.is_dead():
		return
	var target_combat := CombatComponent.find_on(hurtbox.get_entity())
	if target_combat and target_combat.is_invulnerable():
		return
	if target_combat and target_combat.dodges_projectiles():
		target_combat.on_projectile_dodged() # the Thief's ultimate: it does not go off on them (its blast still hits)
		return
	_explode()


func _on_wall_hit() -> void:
	global_position = _wall_point
	if explodes:
		_explode()
	else:
		_spawn_burst(IMPACT_TEXTURE, scale.x)
		super()


## A quick fireball bursts on the one target it hit.
func _on_target_hit(_hurtbox: HitboxComponent) -> void:
	_spawn_burst(IMPACT_TEXTURE, scale.x)


## A blocked quick fireball bursts against the shield instead of snapping like an arrow.
func _break_apart() -> void:
	if _done:
		return
	_spawn_burst(IMPACT_TEXTURE, scale.x)
	_finish()


## Held shot: hits every enemy fighter in the blast once, throwing them away from the centre.
func _explode() -> void:
	if _done:
		return
	_done = true
	var center := global_position
	var radius := radius_override if radius_override > 0.0 else blast_radius(scale.x)

	var circle := CircleShape2D.new()
	circle.radius = radius
	var query := PhysicsShapeQueryParameters2D.new()
	query.shape = circle
	query.transform = Transform2D(0.0, center)
	query.collision_mask = collision_mask
	query.collide_with_areas = true
	query.collide_with_bodies = false
	var results := get_world_2d().direct_space_state.intersect_shape(query, 32)

	var victims: Array[Node2D] = []
	for result in results:
		var victim := result.collider as HitboxComponent
		if victim == null or victims.has(victim.get_entity()):
			continue # a fighter is hit once, even with several hurtboxes
		victims.append(victim.get_entity())
		var offset := victim.global_position - center
		var blast_hit := _blast_hit_for(offset, radius)
		victim.receive_hit(blast_hit)

	_spawn_burst(EXPLOSION_TEXTURE, radius / EXPLOSION_SPRITE_RADIUS)
	Sfx.play(&"finisher", 0.0, EXPLOSION_SOUND_PITCH)
	if is_instance_valid(shooter) and shooter.is_in_group("players"):
		Combat.shake(EXPLOSION_SHAKE, 0.2, Vector2.RIGHT.rotated(rotation))
	if burn_skill != null and burn_skill.dot_mult_per_sec > 0.0 and hit != null:
		BurningGround.spawn(get_parent(), center, burn_skill, hit.attacker, hit.team, burn_damage_per_tick)
	queue_free()


## Copy of the fireball's hit for one victim: damage and knockback fall off toward the rim, knockback points away from the centre.
func _blast_hit_for(offset: Vector2, radius: float) -> HitData:
	var blast := HitData.new()
	blast.attacker = hit.attacker
	blast.team = hit.team
	blast.damage = maxf(hit.damage * falloff(offset.length(), radius, EXPLOSION_EDGE_DAMAGE), 1.0)
	blast.direction = offset.normalized() if offset.length() > 1.0 else Vector2.RIGHT.rotated(rotation)
	blast.reaction = hit.reaction
	blast.stagger_time = hit.stagger_time
	blast.knockback_force_mult = hit.knockback_force_mult * falloff(offset.length(), radius, EXPLOSION_EDGE_KNOCKBACK)
	blast.hitstop = hit.hitstop
	blast.is_ranged = hit.is_ranged
	blast.is_heavy = hit.is_heavy
	blast.is_combo_chain = hit.is_combo_chain
	blast.is_finisher = hit.is_finisher
	blast.charge_points = hit.charge_points
	return blast


func _spawn_burst(texture: Texture2D, burst_scale: float) -> void:
	var parent := get_parent()
	if parent == null:
		return
	var burst := Sprite2D.new()
	burst.texture = texture
	burst.hframes = BURST_FRAMES
	burst.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	burst.z_index = 5
	burst.scale = Vector2.ONE * burst_scale
	parent.add_child(burst)
	burst.global_position = global_position
	var tween := burst.create_tween()
	tween.tween_property(burst, "frame", BURST_FRAMES - 1, BURST_TIME).from(0)
	tween.tween_callback(burst.queue_free)


## A skill fireball that reaches the aimed spot explodes there; other fireballs just fizzle out.
func _on_range_end() -> void:
	if explodes:
		_explode()
	else:
		_spawn_burst(IMPACT_TEXTURE, scale.x)
		_finish()
